# Safe default: no real orders
DRY_RUN=true

# Strategy: trend_rebalance, streak_failure, or aw_liquidity
STRATEGY=trend_rebalance

# Exchange: hyperliquid, okx, or lighter
EXCHANGE=hyperliquid

# Hyperliquid HIP-3
NETWORK=mainnet
DEX=xyz
COIN=xyz:XYZ100
ACCOUNT_ADDRESS=
API_PRIVATE_KEY=

# OKX
OKX_INST_ID=US100-USDT-SWAP
OKX_DEMO=true
OKX_MARGIN_MODE=cross
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com

# Lighter (Core / Robinhood Chain)
# mainnet = Lighter Core, robinhood = Robinhood Chain Lighter
# testnet and robinhood_testnet are also supported.
LIGHTER_PROFILE=mainnet
LIGHTER_SYMBOL=BTC
LIGHTER_ACCOUNT_INDEX=-1
LIGHTER_API_KEY_INDEX=-1
LIGHTER_API_KEY_PRIVATE=

# Shared execution
INTERVAL=1m
ORDER_NOTIONAL_USDC=100
LEVERAGE=0
MAX_SLIPPAGE=0.005
ENABLE_LONGS=true
ENABLE_SHORTS=true
POLL_SECONDS=3
LOOKBACK_CANDLES=500
LOG_LEVEL=INFO

# Strategy 1.0 · Trend Rebalance Map
TREND_SMA50_LENGTH=50
TREND_SMA200_LENGTH=200
TREND_POINT_SIZE=1.0
TREND_MIN_SEPARATION=30.0
TREND_TP_MODE=200 SMA
TREND_SMA_TARGET_BEHAVIOUR=Dynamic
TREND_TP_FIXED_POINTS=100.0
TREND_SL_MODE=Fixed Points
TREND_SL_FIXED_POINTS=125.0

# Strategy 1.1 · Streak Failure Reversal
STREAK_SIGNAL_TIMEFRAME=1m
STREAK_DEFINITION=bodies
STREAK_LENGTH=5
STREAK_WAIT_BARS=15
STREAK_USE_SESSION_FILTER=true
STREAK_SESSION_START=09:45
STREAK_SESSION_END=12:00
STREAK_TRIGGER_MUST_BE_IN_SESSION=true
STREAK_HARD_FLAT=true
STREAK_HARD_FLAT_TIME=16:00
STREAK_SL_MODE=terminal
STREAK_STOP_BUFFER_POINTS=0.0
STREAK_ATR_LENGTH=14
STREAK_ATR_MULT=1.0
STREAK_TP_MODE=r_multiple
STREAK_TP_R=1.0
STREAK_INVALID_TARGET_POLICY=use_r

# Strategy 1.2 · AW Liquidity Reversal
AW_SWING_LENGTH=3
AW_MAX_LIQUIDITY=15
AW_USE_HTF_LIQUIDITY=true
AW_HTF_MINUTES=15
AW_HTF_PIVOT_STRENGTH=2
AW_USE_PDHL=true
AW_ATR_LENGTH=2
AW_DISPLACEMENT_MULT=1.0
AW_MAX_BARS_TO_MSS=30
AW_FVG_SEARCH_WINDOW=1
AW_MAX_BARS_TO_ENTRY=10
AW_USE_ASIA=true
AW_USE_LONDON=true
AW_USE_NYAM=true
AW_USE_NYPM=false
AW_TARGET_MODE=opposite_liquidity
AW_TARGET_R=1.0

# Optional explicit state path. Leave empty for automatic per-strategy/per-exchange path.
STATE_PATH=

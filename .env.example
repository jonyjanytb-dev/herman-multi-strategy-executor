# =============================
# Strategy selector
# trend_rebalance = user version 1.0
# streak_failure  = user version 1.1
# =============================
STRATEGY=trend_rebalance

# Safe default: never send real orders until you explicitly switch mode.
DRY_RUN=true

# Exchange: hyperliquid or okx
EXCHANGE=hyperliquid

# Hyperliquid HIP-3
NETWORK=mainnet
DEX=xyz
COIN=xyz:XYZ100
ACCOUNT_ADDRESS=
API_PRIVATE_KEY=

# OKX linear perpetual
OKX_INST_ID=US100-USDT-SWAP
OKX_MARGIN_MODE=cross
OKX_TRIGGER_PRICE_TYPE=last
OKX_DEMO=true
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com

# Global execution
INTERVAL=1m
ORDER_NOTIONAL_USDC=100
LEVERAGE=0
MAX_SLIPPAGE=0.005
ENABLE_LONGS=true
ENABLE_SHORTS=true

# Strategy 1.0 Trend Rebalance
SMA50_LENGTH=50
SMA200_LENGTH=200
POINT_SIZE=1.0
MIN_SEPARATION=30.0
TP_MODE=200 SMA
SMA_TARGET_BEHAVIOUR=Dynamic
TP_FIXED_POINTS=100.0
SL_MODE=Fixed Points
SL_FIXED_POINTS=125.0

# Strategy 1.1 Streak Failure Reversal
STREAK_SIGNAL_TIMEFRAME=1m
STREAK_DEFINITION=bodies
STREAK_LENGTH=5
STREAK_WAIT_BARS=15
STREAK_USE_SESSION_FILTER=true
STREAK_SESSION_START=09:45
STREAK_SESSION_END=12:00
STREAK_TRIGGER_MUST_BE_IN_SESSION=true
STREAK_HARD_FLAT_ENABLED=true
STREAK_HARD_FLAT=16:00
STREAK_SL_MODE=Terminal streak candle extreme
STREAK_STOP_BUFFER_TICKS=0
STREAK_TICK_SIZE=1.0
STREAK_ATR_LENGTH=14
STREAK_ATR_MULT=1.0
STREAK_TP_MODE=R multiple
STREAK_TP_R=1.0
STREAK_INVALID_TARGET_POLICY=Use R target
STREAK_SIZING_MODE=Fixed notional
STREAK_MAX_RISK_USD=200.0
STREAK_MAX_NOTIONAL_USD=10000.0
STREAK_SIZING_SLIPPAGE_TICKS=1

# Runtime
POLL_SECONDS=3
LOOKBACK_CANDLES=320
STATE_PATH=
LOG_LEVEL=INFO
ENTRY_POSITION_WAIT_SECONDS=5
REQUEST_TIMEOUT=15
REQUEST_RETRY_ATTEMPTS=3
OKX_FILL_TIMEOUT=10
